{
  "components": {
    "schemas": {
      "ActionSubmissionBody": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "additionalProperties": true,
            "title": "Action",
            "type": "object"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "observed_projection_hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Observed Projection Hash",
            "type": "string"
          },
          "rationale_summary": {
            "default": "",
            "maxLength": 500,
            "title": "Rationale Summary",
            "type": "string"
          },
          "target_tick": {
            "minimum": 1.0,
            "title": "Target Tick",
            "type": "integer"
          }
        },
        "required": [
          "target_tick",
          "action",
          "observed_projection_hash",
          "idempotency_key"
        ],
        "title": "ActionSubmissionBody",
        "type": "object"
      },
      "AuthorizationBody": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          },
          "code_challenge": {
            "maxLength": 128,
            "minLength": 43,
            "title": "Code Challenge",
            "type": "string"
          },
          "code_challenge_method": {
            "const": "S256",
            "default": "S256",
            "title": "Code Challenge Method",
            "type": "string"
          },
          "connection_id": {
            "maxLength": 64,
            "minLength": 16,
            "title": "Connection Id",
            "type": "string"
          },
          "redirect_uri": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Redirect Uri",
            "type": "string"
          },
          "scope": {
            "default": "",
            "title": "Scope",
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "tenant_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "connection_id",
          "client_id",
          "redirect_uri",
          "code_challenge"
        ],
        "title": "AuthorizationBody",
        "type": "object"
      },
      "CommonsActionBody": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "additionalProperties": true,
            "title": "Action",
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "title": "CommonsActionBody",
        "type": "object"
      },
      "ConnectionCreateBody": {
        "additionalProperties": false,
        "properties": {
          "biography": {
            "default": "",
            "maxLength": 500,
            "title": "Biography",
            "type": "string"
          },
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "preferred_occupation": {
            "default": "",
            "maxLength": 80,
            "title": "Preferred Occupation",
            "type": "string"
          },
          "scopes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scopes"
          },
          "tier": {
            "enum": [
              "observer",
              "commons",
              "actor"
            ],
            "title": "Tier",
            "type": "string"
          },
          "wake_interval_ticks": {
            "default": 1,
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Wake Interval Ticks",
            "type": "integer"
          }
        },
        "required": [
          "display_name",
          "tier"
        ],
        "title": "ConnectionCreateBody",
        "type": "object"
      },
      "ConnectionUpdateBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "active",
              "suspended",
              "revoked"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ConnectionUpdateBody",
        "type": "object"
      },
      "CredentialBody": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "rotate",
              "revoke"
            ],
            "title": "Action",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "CredentialBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OAuthClientRegistrationBody": {
        "additionalProperties": false,
        "properties": {
          "client_name": {
            "default": "MCP client",
            "maxLength": 200,
            "minLength": 1,
            "title": "Client Name",
            "type": "string"
          },
          "grant_types": {
            "items": {
              "type": "string"
            },
            "title": "Grant Types",
            "type": "array"
          },
          "redirect_uris": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Redirect Uris",
            "type": "array"
          },
          "response_types": {
            "items": {
              "type": "string"
            },
            "title": "Response Types",
            "type": "array"
          },
          "token_endpoint_auth_method": {
            "const": "none",
            "default": "none",
            "title": "Token Endpoint Auth Method",
            "type": "string"
          }
        },
        "required": [
          "redirect_uris"
        ],
        "title": "OAuthClientRegistrationBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
