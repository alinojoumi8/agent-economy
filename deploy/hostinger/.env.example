AGENT_ECONOMY_PUBLIC_HOST=
AGENT_ECONOMY_PUBLIC_BASE_URL=
AGENT_ECONOMY_IMAGE_TAG=local
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
SUPERVISOR_DATABASE_PASSWORD=
CATALOG_BACKUP_PASSWORD=
# Separate server, for example backups.example.net:22. No Amazon account needed.
AE_BACKUP_SFTP_HOST=
AE_BACKUP_SFTP_USER=
# A different account, forced to read-only SFTP on the same run backup tree.
AE_RESTORE_SFTP_USER=
# Separate account/chroot for catalog dumps; inaccessible to the web app.
AE_CATALOG_SFTP_USER=
AE_CATALOG_SFTP_PATH=
# The verified value starts with ssh-ed25519 or ssh-rsa, followed by base64.
AE_BACKUP_SFTP_HOST_KEY=
# A dedicated directory, e.g. /backups/agent-economy. Existing runs never share it.
AE_BACKUP_SFTP_PATH=
