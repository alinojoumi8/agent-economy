+"""Create authentic pre-population storage for additive upgrade tests."""
+from contextlib import contextmanager
+
+import pytest
+
+import engine.schema as schema
+import engine.store as store_module
+from engine.migrations import registry
+
+
+@contextmanager
+def legacy_schema25():
+    """Limit storage creation to schema 25, restoring public registration on exit.
+
+    Callers must close every writable Store before leaving this context. Stored
+    run semantics are supplied explicitly by each test and are never rewritten.
+    """
+    assert schema.SCHEMA_VERSION == store_module.SCHEMA_VERSION == 26
+    assert registry.registered_migrations()[-1].version == 26
+    with pytest.MonkeyPatch.context() as patch:
+        patch.setattr(registry, "_MIGRATIONS", tuple(
+            migration for migration in registry.registered_migrations()
+            if migration.version <= 25))
+        patch.setattr(schema, "SCHEMA_VERSION", 25)
+        patch.setattr(store_module, "SCHEMA_VERSION", 25)
+        yield
