# Required only for runs/production.yaml. Never commit populated values.
# MiniMax Token Plan key (sk-cp-*).
MINIMAX_API_KEY=
# Kimi Code membership key (sk-kimi-*); production.yaml uses the Kimi Code API.
KIMI_API_KEY=
ANTHROPIC_API_KEY=

# Optional R22 Compose deployment. Copy to the ignored .env file, populate
# every required value with a strong value, and keep all identities distinct.
POSTGRES_PASSWORD=
# Used only by the profile-gated rotation job; clear it immediately afterward.
AGENT_ECONOMY_NEW_POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
SUPERVISOR_DATABASE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AGENT_ECONOMY_PUBLIC_BASE_URL=https://localhost:8443
AGENT_ECONOMY_PUBLIC_HOST=localhost
HTTPS_PORT=8443
